# =============================================================================
# Backend Environment
# =============================================================================
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+asyncpg://mirage_user:mirage_password@postgres:5432/mirage_dev
REDIS_URL=redis://redis:6379/0
DEMO_MODE=true
SYMPTOM_PROVIDER=mock
AI_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock
EMAIL_PROVIDER=mailhog
STORAGE_PROVIDER=local
LOG_LEVEL=INFO

# =============================================================================
# LLM Configuration (required - set in your local .env, never commit real values)
# =============================================================================
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name
POSTGRES_PASSWORD=change-me-in-production

# =============================================================================
# Frontend Environment
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_WS_URL=ws://localhost:8002/ws
NEXT_PUBLIC_DEMO_MODE=true
